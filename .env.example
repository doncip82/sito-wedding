# Google tag (gtag.js) + Google Ads conversion tracking.
# Set the real values as Environment Variables in Vercel (Project → Settings →
# Environment Variables). Leave them empty locally to keep tracking disabled.
# All three are exposed to the client bundle (VITE_ prefix) — do not put secrets here.

# The Google tag id (Google Ads → gtag install), format: AW-XXXXXXXXXX
VITE_GOOGLE_TAG_ID=

# Google Ads conversion action id, format: AW-XXXXXXXXXX
VITE_GOOGLE_ADS_CONVERSION_ID=

# Google Ads conversion label (the string after the slash in send_to)
VITE_GOOGLE_ADS_CONVERSION_LABEL=
