# Google tag (gtag.js) + Consent Mode v2.
# Set the real value as an Environment Variable in Vercel (Project → Settings →
# Environment Variables). Leave it empty locally to keep tracking disabled.
# Exposed to the client bundle (VITE_ prefix) — do not put secrets here.

# The Google tag id (Google Ads → gtag install), format: AW-XXXXXXXXXX
VITE_GOOGLE_TAG_ID=

# NOTE: The Google Ads conversion is tracked by the load of the /thank-you page
# (Ads rule: "URL contains /thank-you"), so no conversion id / label env vars
# are needed anymore.
